# Themenbaum ohne LLM – Konfiguration
# Hostinger übernimmt diese Datei beim ersten Deploy als .env. Danach im Docker Manager
# „Bearbeiten“ → .env ausfüllen und neu bereitstellen. Keine echten Werte ins Repository schreiben.

# Domain, unter der die App erreichbar sein soll – nur der Hostname, ohne https:// und ohne Pfad.
# Beispiel: themenbaum.meine-domain.de   Ohne eigene Domain: der VPS-Hostname srvNNNNNN.hstgr.cloud
DOMAIN=

# Zugangspasswort für die Login-Seite. Solange es leer ist, bleibt die App gesperrt.
APP_PASSWORD=

# Kontakt (E-Mail oder URL) für den User-Agent. Wikimedia lehnt Anfragen ohne Kontakt ab;
# ohne diesen Wert funktionieren Wikipedia und Wikidata nicht, die GND schon.
WIKIMEDIA_CONTACT=

# Optional: fester Schlüssel für Sitzungs-Cookies. Leer = wird beim ersten Start zufällig erzeugt
# und im Daten-Volume gespeichert.
SESSION_SECRET=

# Optional: Dauer einer Anmeldung in Stunden (Standard 168 = 7 Tage).
SESSION_HOURS=

# Optional: Cookies nur über HTTPS senden (Standard true). Nur für lokale Tests ohne HTTPS auf false setzen.
COOKIE_SECURE=

# Optional: Image-Tag (Standard main = jeweils neuester Stand des main-Branches).
IMAGE_TAG=

# Optional: Traefik-Einstellungen, nur ändern, wenn der VPS anders konfiguriert ist.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=

# Nur für docker-compose.build.yml (lokal): Port auf dem eigenen Rechner (Standard 8000).
HOST_PORT=
